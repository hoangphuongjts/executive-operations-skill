# Copy to .env; never commit .env. Generate a random value locally (python -c "import secrets;print(secrets.token_urlsafe(32))")
AGENT_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS
# Do not enable until you approve where tasks/documents are sent.
AGENT_ALLOW_EXTERNAL=0
# Example local Ollama (outside Docker):
# AGENT_MODEL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# AGENT_MODEL_NAME=<YOUR_DOWNLOADED_MODEL>
# Inside Docker with Ollama on host:
# AGENT_MODEL_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
# AGENT_MODEL_NAME=<YOUR_DOWNLOADED_MODEL>
# For cloud provider, HTTPS ONLY; never commit real key.
AGENT_MODEL_ENDPOINT=
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=
AGENT_OUTPUT_TOKENS=256
AGENT_MODEL_TIMEOUT=20
AGENT_DB_PATH=/data/agents.sqlite3
AGENT_ALLOW_PUBLIC_BIND=1
